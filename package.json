{
	"name": "conductor-remote",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "yarn@4.15.0",
	"description": "Phone control panel for local Conductor agents. Reads ride SQLite + git; prompts ride Conductor's own dispatch path.",
	"license": "MIT",
	"author": "Eivind Hyldmo",
	"homepage": "https://github.com/hyldmo/conductor-remote#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyldmo/conductor-remote.git"
	},
	"bugs": {
		"url": "https://github.com/hyldmo/conductor-remote/issues"
	},
	"keywords": [
		"conductor",
		"claude-code",
		"coding-agents",
		"remote-control",
		"pwa",
		"tailscale",
		"sqlite"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node --experimental-transform-types --disable-warning=ExperimentalWarning src/server.ts",
		"relay": "node --experimental-transform-types --disable-warning=ExperimentalWarning --watch src/server.ts",
		"dev": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/dev.ts",
		"dev:web": "vite",
		"build": "vite build",
		"preview": "yarn build && yarn start",
		"gen:icons": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/gen-icons.ts",
		"deploy": "yarn build && node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/service.ts install",
		"service": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/service.ts",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"fix": "biome check . --fix",
		"verify": "yarn typecheck && yarn lint"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.90.20",
		"clsx": "^2.1.1",
		"lucide-react": "^0.563.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0",
		"react-router": "^7.15.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.4.0",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24.7.0",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.0.4",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-pwa": "^1.2.0"
	}
}
